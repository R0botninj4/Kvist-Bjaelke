# Kopiér til .env eller kør scripts/setup.ps1. Commit aldrig .env.
JWT_SECRET=
ADMIN_USERNAME=admin
# 12-128 characters; only used when initializing an empty database.
ADMIN_PASSWORD=
# Ubuntu: serverens faktiske IPv4-adresse på VLAN 571.
# Lokal Docker: behold 127.0.0.1.
WEB_BIND_ADDRESS=127.0.0.1
