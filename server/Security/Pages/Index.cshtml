@page
@model IndexModel
@{ ViewData["Title"] = "Brugere"; }

<h1>Brugere</h1>
@if (Model.CanEdit) { <a asp-page="Index" asp-route-create="true">Opret bruger</a> }
@if (Model.Message != null) { <p class="success" role="status">@Model.Message</p> }

@if (Model.ShowForm)
{
    <section class="editor">
        <h2>@(Model.Input.Id == 0 ? "Opret bruger" : "Rediger bruger")</h2>
        <form method="post" asp-page-handler="Save">
            <div asp-validation-summary="All" class="error" role="alert"></div>
            <input asp-for="Input.Id" type="hidden" />
            <label asp-for="Input.Username">Brugernavn</label>
            <input asp-for="Input.Username" required minlength="3" maxlength="50" autocomplete="off" />
            <label asp-for="Input.Role">Rolle</label>
            <select asp-for="Input.Role">
                <option value="User">User</option>
                @if (Model.IsAdmin)
                {
                    <option value="SuperUser">SuperUser</option>
                    <option value="Admin">Admin</option>
                }
            </select>
            <label asp-for="Input.Password">@(Model.Input.Id == 0 ? "Adgangskode" : "Ny adgangskode (valgfri)")</label>
            <input name="Input.Password" id="Input_Password" type="password" minlength="12" maxlength="128" autocomplete="new-password" />
            <small>12-128 tegn. Ved redigering kan feltet være tomt for at beholde adgangskoden.</small>
            <div class="actions"><button>Gem</button><a asp-page="Index">Annuller</a></div>
        </form>
    </section>
}

<section class="table-wrap">
    <table>
        <thead><tr><th>Brugernavn</th><th>Rolle</th><th>Oprettet</th><th>Handlinger</th></tr></thead>
        <tbody>
        @foreach (var user in Model.Users)
        {
            <tr>
                <td>@user.Username @(user.Id == Model.CurrentUserId ? "(dig)" : "")</td>
                <td>@user.Role</td>
                <td>@user.CreatedAt.ToString("dd-MM-yyyy")</td>
                <td>
                    @if (Model.CanEdit)
                    {
                        <div class="actions">
                            <a asp-page="Index" asp-route-editId="@user.Id">Rediger</a>
                            @if (user.Id != Model.CurrentUserId)
                            {
                                <details><summary>Slet</summary>
                                    <form method="post" asp-page-handler="Delete">
                                        <input type="hidden" name="id" value="@user.Id" />
                                        <span>Slet @user.Username permanent?</span>
                                        <button>Bekræft sletning</button>
                                    </form>
                                </details>
                            }
                        </div>
                    }
                    else { <span class="muted">Kun læsning</span> }
                </td>
            </tr>
        }
        @if (Model.Users.Count == 0) { <tr><td colspan="4">Der er ingen almindelige brugere endnu.</td></tr> }
        </tbody>
    </table>
</section>
<p class="muted">@(Model.IsAdmin ? "Admin kan administrere alle tre roller." : Model.CanEdit ? "SuperUser kan oprette, læse, redigere og slette User-konti." : "User har kun læseadgang til User-konti.")</p>
