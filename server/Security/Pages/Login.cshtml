@page
@model LoginModel
@{ ViewData["Title"] = "Log ind"; }

<section class="login">
    <h1>Log ind</h1>
    <form method="post">
        <div asp-validation-summary="All" class="error" role="alert"></div>
        <label asp-for="Username">Brugernavn</label>
        <input asp-for="Username" autocomplete="username" required maxlength="50" />
        <label asp-for="Password">Adgangskode</label>
        <input asp-for="Password" type="password" autocomplete="current-password" required maxlength="128" />
        <button>Log ind</button>
    </form>
</section>
